PORT=3000
# APS가 접근할 수 있는 이 서버의 HTTPS 주소. Codespaces 포트는 공개 설정 필요.
PUBLIC_BASE_URL=https://your-api.example.com
# 별도 정적 호스팅을 사용할 경우 정확한 사이트 origin. 같은 서버면 비워 둡니다.
FRONTEND_ORIGIN=
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_ACTIVITY_ID=yourNickname.DwgPdf+production
APS_REGION=us-east
APS_ENGINE=Autodesk.AutoCAD+25_1
APS_BUNDLE_ID=DwgPdf
APS_ACTIVITY_NAME=DwgPdf
APS_ALIAS=production
MAX_UPLOAD_MB=100
MAX_JOBS=4
JOB_TTL_MINUTES=60
# 배포 시 사용자 인증/쿼터를 앞단 프록시에서 적용하세요.
